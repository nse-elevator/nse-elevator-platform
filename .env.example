# ================================================================
# 1. Express Backend Server Environment Variables
# (Used when deploying the backend API on Render / Railway / VPS)
# ================================================================
PORT=5000
NODE_ENV=production

# MongoDB Connection String (from MongoDB Atlas Free M0 cluster)
# Example: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/vanguard_elevator?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_user:your_password@cluster0.example.mongodb.net/vanguard_elevator?retryWrites=true&w=majority

# Allowed frontend origin for CORS
# (Set to your production Vercel/custom domain, e.g. https://your-site.vercel.app or https://nsei.in)
ALLOWED_ORIGIN=https://your-site.vercel.app

# JWT Secret for admin session tokens (Use a strong 32+ character random string)
JWT_SECRET=generate-a-strong-random-jwt-secret-here-at-least-32-chars

# Admin Default Seed Credentials
ADMIN_SEED_NAME="NSE Administrator"
ADMIN_SEED_EMAIL=admin@nsei.in
ADMIN_SEED_PASSWORD=YourSecureAdminPassword2026!

# Email / Lead Notification
EMAIL_FROM=office.pune@nsei.in
LEAD_NOTIFICATION_EMAIL=office.pune@nsei.in


# ================================================================
# 2. Next.js Frontend Environment Variables
# (Set these in Vercel Project Settings -> Environment Variables)
# ================================================================

# Public API URL for client-side queries (Your deployed backend URL + /api)
# Example: https://nse-api.onrender.com/api
NEXT_PUBLIC_API_BASE_URL=https://your-backend-api.onrender.com/api

# Internal Backend URL for Next.js Server-Side API proxy routes
# Example: https://nse-api.onrender.com
BACKEND_INTERNAL_URL=https://your-backend-api.onrender.com

# Analytics & Tracking (Optional - replace with real IDs before launch)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_CLARITY_ID=clarity_project_id_placeholder
